# Polaris Agentic RAG environment example (placeholders only)
# Copy to .env and fill real values locally. NEVER commit real .env.

# --- Application ---
DKA_ENVIRONMENT=development
DKA_LOG_LEVEL=INFO

# --- LightRAG adapter (Stage 1+) ---
# DKA_LIGHTRAG_DEFAULT_QUERY_MODE=hybrid
# DKA_LIGHTRAG_DEFAULT_TOP_K=20
# DKA_LIGHTRAG_ENABLE_RERANK=false

# --- LLM provider: DeepSeek (OpenAI compatible) ---
# 真实 key 只放本地 .env，禁止 commit
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DKA_LIGHTRAG_LLM_MODEL=deepseek-chat
DKA_LIGHTRAG_LLM_BASE_URL=https://api.deepseek.com/v1
DKA_LIGHTRAG_LLM_TIMEOUT=180

# --- Embedding provider: Ollama (本地) ---
DKA_LIGHTRAG_OLLAMA_HOST=http://localhost:11434
DKA_LIGHTRAG_EMBED_MODEL=bge-m3:latest

# --- Ollama 本地 LLM 备援 (可选) ---
DKA_LIGHTRAG_OLLAMA_LLM_MODEL=qwen2.5:3b

# --- Rerank (可选，未配置则不执行 rerank baseline) ---
# DKA_LIGHTRAG_RERANK_MODEL=